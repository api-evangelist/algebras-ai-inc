{
  "opencollection": "1.0.0",
  "info": {
    "name": "Algebras Authentication Storage API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a signed URL for uploading a video file to storage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.algebras.ai/api/v1/storage/upload-url",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns a signed URL that allows the client to upload a video file directly to cloud storage. Supported formats: `video/mp4`, `video/quicktime`, `video/x-matroska`, `video/webm`\n"
        }
      ]
    }
  ],
  "bundled": true
}