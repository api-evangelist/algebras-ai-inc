{
  "opencollection": "1.0.0",
  "info": {
    "name": "Algebras Authentication Common API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Common",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check endpoint",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform.algebras.ai/api/v1/health"
          },
          "docs": "Returns the health status of the API. This endpoint is publicly accessible and does not require authentication."
        }
      ]
    }
  ],
  "bundled": true
}