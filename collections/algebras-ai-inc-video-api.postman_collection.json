          "name": "Start translation of an uploaded video file",
          "request": {
            "name": "Start translation of an uploaded video file",
            "description": {
              "content": "Starts the video translation process for a video that was previously uploaded to storage. The video must be in UPLOADED or READY status. This will extract audio, transcribe it, translate the transcription, synthesize new audio, and create the final translated video.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "video",
                "translate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoId\": \"<string>\",\n  \"targetLanguage\": \"<string>\",\n  \"voicePreference\": \"<string>\",\n  \"numSpeakers\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
